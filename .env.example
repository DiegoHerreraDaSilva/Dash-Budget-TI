# ===== Microsoft Graph (dados ao vivo do SharePoint) =====
# App Registration no Entra ID com a permissao de aplicacao Sites.Selected
# (privilegio minimo) + concessao de leitura no site abaixo, e um Client Secret
# valido. Peca os valores a quem administra o ambiente.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Host e caminho do site do SharePoint
SHAREPOINT_HOSTNAME=<tenant>.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/<nome-do-site>

# Nome (displayName, nome interno ou ID) de cada lista
SHAREPOINT_LIST_GASTOS=Investimentos de TI
SHAREPOINT_LIST_PREVISTO=Budget de TI
SHAREPOINT_LIST_META=Valor Budget

# Se "true", usa o snapshot local (src/lib/seed.ts) e ignora o Graph.
USE_SEED_DATA=true

# ===== Restricao de acesso por IP (opcional) =====
# So tem efeito rodando via "npm run start:secure" (server.js), que le o IP
# real da conexao TCP (nao confia em headers como X-Forwarded-For). Lista
# separada por virgula, aceitando IPs individuais e faixas CIDR. Vazio/ausente
# libera qualquer IP.
# ALLOWED_IPS=10.0.0.15,10.0.0.16,192.168.1.0/24
